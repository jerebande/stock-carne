<%- include('../partials/header') %>

<div class="toolbar">
  <h2 style="margin:0;">Productos</h2>
  <a href="/productos/nuevo" class="btn">+ Nuevo producto</a>
</div>

<div class="card">
  <form method="GET" class="filtros" style="margin-bottom:1rem;">
    <input type="text" name="q" placeholder="Buscar por nombre..." value="<%= q || '' %>">
    <select name="categoria">
      <option value="">Todas las categorías</option>
      <% categorias.forEach(c => { %>
        <option value="<%= c.id %>" <%= String(categoria) === String(c.id) ? 'selected' : '' %>><%= c.nombre %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn secundario">Filtrar</button>
  </form>

  <div class="table-scroll"><table>
    <thead>
      <tr>
        <th>Nombre</th><th>Categoría</th><th>Stock</th><th>Mínimo</th>
        <th>Precio costo</th><th>Precio venta</th><th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% productos.forEach(p => { %>
        <tr>
          <td data-label="Producto"><strong><%= p.nombre %></strong></td>
          <td data-label="Categoría"><%= p.categoria_nombre || '-' %></td>
          <td data-label="Stock actual">
            <% if (Number(p.stock_actual) <= Number(p.stock_minimo)) { %>
              <span class="badge bajo"><%= p.stock_actual %> <%= p.unidad %></span>
            <% } else { %>
              <%= p.stock_actual %> <%= p.unidad %>
            <% } %>
          </td>
          <td data-label="Mínimo"><%= p.stock_minimo %> <%= p.unidad %></td>
          <td data-label="Precio costo">$<%= Number(p.precio_costo).toFixed(2) %></td>
          <td data-label="Precio venta">$<%= Number(p.precio_venta).toFixed(2) %></td>
          <td data-label="Acciones" class="table-actions">
            <a href="/productos/<%= p.id %>/editar" class="btn secundario" style="padding:0.3rem 0.7rem;">Editar</a>
            <% if (usuario.rol === 'admin') { %>
              <form action="/productos/<%= p.id %>?_method=DELETE" method="POST" class="inline"
                    onsubmit="return confirm('¿Eliminar este producto?');">
                <button type="submit" class="btn peligro" style="padding:0.3rem 0.7rem;">Eliminar</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (productos.length === 0) { %>
        <tr class="table-empty"><td colspan="7">No se encontraron productos.</td></tr>
      <% } %>
    </tbody>
  </table></div>
</div>

<%- include('../partials/footer') %>
