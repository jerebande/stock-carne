<%- include('../partials/header') %>

<div class="card" style="max-width:600px;">
  <h2 style="margin-top:0;"><%= producto ? 'Editar producto' : 'Nuevo producto' %></h2>
  <form method="POST" action="<%= producto ? `/productos/${producto.id}?_method=PUT` : '/productos' %>">
    <div class="form-group">
      <label>Nombre</label>
      <input type="text" name="nombre" required value="<%= producto ? producto.nombre : '' %>">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Categoría</label>
        <select name="categoria_id">
          <option value="">Sin categoría</option>
          <% categorias.forEach(c => { %>
            <option value="<%= c.id %>" <%= producto && producto.categoria_id === c.id ? 'selected' : '' %>><%= c.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Unidad</label>
        <select name="unidad">
          <option value="kg" <%= producto && producto.unidad === 'kg' ? 'selected' : '' %>>Kilogramos (kg)</option>
          <option value="unidad" <%= producto && producto.unidad === 'unidad' ? 'selected' : '' %>>Unidad</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Precio de costo</label>
        <input type="number" step="0.01" name="precio_costo" value="<%= producto ? producto.precio_costo : 0 %>">
      </div>
      <div class="form-group">
        <label>Precio de venta</label>
        <input type="number" step="0.01" name="precio_venta" value="<%= producto ? producto.precio_venta : 0 %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Stock inicial <% if (producto) { %>(no editable acá — usá "Movimientos")<% } %></label>
        <input type="number" step="0.01" name="stock_actual" value="<%= producto ? producto.stock_actual : 0 %>" <%= producto ? 'disabled' : '' %>>
      </div>
      <div class="form-group">
        <label>Stock mínimo (alerta)</label>
        <input type="number" step="0.01" name="stock_minimo" value="<%= producto ? producto.stock_minimo : 0 %>">
      </div>
    </div>

    <div class="form-group">
      <label>Proveedor</label>
      <select name="proveedor_id">
        <option value="">Sin proveedor</option>
        <% proveedores.forEach(pr => { %>
          <option value="<%= pr.id %>" <%= producto && producto.proveedor_id === pr.id ? 'selected' : '' %>><%= pr.nombre %></option>
        <% }) %>
      </select>
    </div>

    <button type="submit" class="btn">Guardar</button>
    <a href="/productos" class="btn secundario">Cancelar</a>
  </form>
</div>

<%- include('../partials/footer') %>
