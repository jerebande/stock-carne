<%- include('partials/header') %>

<div class="grid-stats">
  <div class="card stat">
    <div class="num"><%= total_productos %></div>
    <div class="label">Productos activos</div>
  </div>
  <div class="card stat">
    <div class="num"><%= bajoStock.length %></div>
    <div class="label">Con stock bajo</div>
  </div>
  <div class="card stat">
    <div class="num">$<%= Number(valor_stock).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></div>
    <div class="label">Valor total en stock (costo)</div>
  </div>
</div>

<div class="card">
  <div class="toolbar">
    <h3 style="margin:0;">⚠️ Productos con stock bajo</h3>
    <a href="/movimientos/nuevo" class="btn">+ Nuevo movimiento</a>
  </div>
  <% if (bajoStock.length === 0) { %>
    <p style="color:#6b615a;">Todo el stock está por encima del mínimo. 👍</p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Producto</th><th>Categoría</th><th>Stock actual</th><th>Mínimo</th></tr>
      </thead>
      <tbody>
        <% bajoStock.forEach(p => { %>
          <tr>
            <td><%= p.nombre %></td>
            <td><%= p.categoria_nombre || '-' %></td>
            <td><span class="badge bajo"><%= p.stock_actual %> <%= p.unidad %></span></td>
            <td><%= p.stock_minimo %> <%= p.unidad %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="card">
  <h3 style="margin-top:0;">Últimos movimientos</h3>
  <% if (ultimosMovimientos.length === 0) { %>
    <p style="color:#6b615a;">Todavía no hay movimientos registrados.</p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Usuario</th></tr>
      </thead>
      <tbody>
        <% ultimosMovimientos.forEach(m => { %>
          <tr>
            <td><%= new Date(m.fecha).toLocaleString('es-AR') %></td>
            <td><%= m.producto_nombre %></td>
            <td><span class="badge <%= m.tipo %>"><%= m.tipo %></span></td>
            <td><%= m.cantidad %></td>
            <td><%= m.usuario_nombre || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/footer') %>
