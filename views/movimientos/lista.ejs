<%- include('../partials/header') %>

<div class="toolbar">
  <h2 style="margin:0;">Movimientos de stock</h2>
  <a href="/movimientos/nuevo" class="btn">+ Nuevo movimiento</a>
</div>

<div class="card">
  <div class="table-scroll"><table>
    <thead>
      <tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Motivo</th><th>Usuario</th></tr>
    </thead>
    <tbody>
      <% movimientos.forEach(m => { %>
        <tr>
          <td data-label="Fecha"><%= new Date(m.fecha).toLocaleString('es-AR') %></td>
          <td data-label="Producto"><strong><%= m.producto_nombre %></strong></td>
          <td data-label="Tipo"><span class="badge <%= m.tipo %>"><%= m.tipo %></span></td>
          <td data-label="Cantidad"><%= m.cantidad %> <%= m.unidad %></td>
          <td data-label="Motivo"><%= m.motivo || '-' %></td>
          <td data-label="Usuario"><%= m.usuario_nombre || '-' %></td>
        </tr>
      <% }) %>
      <% if (movimientos.length === 0) { %>
        <tr class="table-empty"><td colspan="6">Todavía no hay movimientos.</td></tr>
      <% } %>
    </tbody>
  </table></div>
</div>

<%- include('../partials/footer') %>
