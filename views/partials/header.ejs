<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#8c1c13">
  <title>Control de Stock - <%= negocioConfig.nombre %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="tema-<%= negocioConfig.tema %>">
<% if (usuario) { %>
  <div class="navbar">
    <a href="/" class="brand"><%= negocioConfig.icono %> <span><%= negocioConfig.nombre %> - Stock</span></a>
    <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-controls="navMenu" aria-expanded="false">☰</button>
    <nav id="navMenu">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Panel</a>
      <a href="/productos" class="<%= path.startsWith('/productos') ? 'active' : '' %>">Productos</a>
      <a href="/movimientos" class="<%= path.startsWith('/movimientos') ? 'active' : '' %>">Movimientos</a>
      <a href="/reportes" class="<%= path.startsWith('/reportes') ? 'active' : '' %>">Reportes</a>
      <a href="/asistente" class="<%= path.startsWith('/asistente') ? 'active' : '' %>">Asistente</a>
      <% if (usuario.rol === 'admin') { %>
        <a href="/categorias" class="<%= path.startsWith('/categorias') ? 'active' : '' %>">Categorías</a>
        <a href="/proveedores" class="<%= path.startsWith('/proveedores') ? 'active' : '' %>">Proveedores</a>
      <% } %>
      <form action="/configuracion/rubro" method="POST" class="selector-negocio">
        <label class="sr-only" for="rubroSelect">Rubro</label>
        <select id="rubroSelect" name="negocio" onchange="this.form.submit()" aria-label="Seleccionar rubro de negocio">
          <% Object.entries(opcionesNegocio).forEach(([key, opcion]) => { %>
            <option value="<%= key %>" <%= negocio === key ? 'selected' : '' %>><%= opcion.nombre %></option>
          <% }) %>
        </select>
      </form>
      <span class="usuario-info" title="<%= usuario.nombre %>">👤 <%= usuario.nombre %></span>
      <form action="/logout" method="POST" class="inline">
        <button type="submit" class="btn-salir">Salir</button>
      </form>
    </nav>
  </div>
  <script>
    document.getElementById('menuToggle').addEventListener('click', function () {
      var nav = document.getElementById('navMenu');
      var abierto = nav.classList.toggle('abierto');
      this.setAttribute('aria-expanded', abierto);
    });
  </script>
<% } %>
<div class="container">
  <% if (success && success.length) { %>
    <% success.forEach(msg => { %><div class="alert success"><%= msg %></div><% }) %>
  <% } %>
  <% if (error && error.length) { %>
    <% error.forEach(msg => { %><div class="alert error"><%= msg %></div><% }) %>
  <% } %>
