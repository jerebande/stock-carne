<%- include('../partials/header') %>

<div class="card" style="max-width:520px;">
  <h2 style="margin-top:0;"><%= proveedor ? 'Editar proveedor' : 'Nuevo proveedor' %></h2>
  <form method="POST" action="<%= proveedor ? `/proveedores/${proveedor.id}?_method=PUT` : '/proveedores' %>">
    <div class="form-group">
      <label>Nombre</label>
      <input type="text" name="nombre" required value="<%= proveedor ? proveedor.nombre : '' %>">
    </div>
    <div class="form-group">
      <label>Teléfono</label>
      <input type="text" name="telefono" value="<%= proveedor ? (proveedor.telefono || '') : '' %>">
    </div>
    <div class="form-group">
      <label>Notas</label>
      <input type="text" name="notas" value="<%= proveedor ? (proveedor.notas || '') : '' %>">
    </div>
    <button type="submit" class="btn">Guardar</button>
    <a href="/proveedores" class="btn secundario">Cancelar</a>
  </form>
</div>

<%- include('../partials/footer') %>
