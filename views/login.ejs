<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar sesión - Control de Stock</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-page">
    <div class="login-box">
      <a href="/login" class="auth-brand">🥩 Control de Stock</a>
      <p class="auth-subtitle">Ingresá para administrar tu inventario.</p>
      <% if (typeof error !== 'undefined' && error.length) { %>
        <% error.forEach(msg => { %><div class="alert error"><%= msg %></div><% }) %>
      <% } %>
      <form action="/login" method="POST">
        <div class="form-group">
          <label for="usuario">Usuario</label>
          <input id="usuario" type="text" name="usuario" required autofocus autocomplete="username" maxlength="30">
        </div>
        <div class="form-group">
          <label for="password">Contraseña</label>
          <input id="password" type="password" name="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn auth-submit">Ingresar</button>
      </form>
      <p class="auth-switch">¿Todavía no tenés cuenta? <a href="/registro">Crear cuenta</a></p>
    </div>
  </div>
</body>
</html>
